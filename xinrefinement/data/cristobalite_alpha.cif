  '-y+1/2, x+1/2, z+1/4'
  '-x, -y, z+1/2'
  'y+1/2, -x+1/2, z+3/4'
  'x+1/2, -y+1/2, -z+3/4'
  '-x+1/2, y+1/2, -z+1/4'
  'y, x, -z'
  '-y, -x, -z+1/2'

loop_
_atom_site_label
_atom_site_fract_x
_atom_site_fract_y
_atom_site_fract_z
_atom_site_occupancy
_atom_site_B_iso_or_equiv
